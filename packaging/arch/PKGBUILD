# Maintainer: Paolo
# Build automatico da upstream scummvm/scummvm (master), tutti i motori,
# release mode, con supporto shader OpenGL.
#
# Varianti (variabile d'ambiente SCUMMVM_VARIANT, default "avx2"):
#   avx2   -> pacchetto Arch normale, ottimizzato AVX2 (scummvm-git)
#   znver3 -> pacchetto CachyOS per CPU AMD Zen 3 (scummvm-git-znver3)
_variant="${SCUMMVM_VARIANT:-avx2}"
case "$_variant" in
  avx2)
    pkgname=scummvm-git
    _desc="AVX2"
    _conflicts=(scummvm scummvm-git-znver3)
    ;;
  znver3)
    pkgname=scummvm-git-znver3
    _desc="znver3"
    _conflicts=(scummvm scummvm-git)
    ;;
  *)
    echo "SCUMMVM_VARIANT non valida: $_variant (usa avx2 o znver3)" >&2
    return 1
    ;;
esac
pkgver=r0
pkgrel=1
pkgdesc="ScummVM (build da master, tutti i motori, ${_desc}, shader OpenGL)"
arch=('x86_64')
url="https://www.scummvm.org/"
license=('GPL')
depends=(
  sdl2 sdl2_net freetype2 libpng libjpeg-turbo giflib
  libtheora faad2 libmad libvorbis libogg flac libmpeg2
  fluidsynth speex speexdsp libvpx curl glew mesa gtk3
  zlib bzip2 libutf8proc
)
makedepends=(git nasm pkgconf)
provides=('scummvm')
conflicts=("${_conflicts[@]}")
source=("scummvm::git+https://github.com/scummvm/scummvm.git#branch=master")
sha256sums=('SKIP')

pkgver() {
  cd scummvm
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd scummvm

  if [ "$_variant" = znver3 ]; then
    # I flag di makepkg.conf contengono -march=x86-64: vanno messi PRIMA dei
    # nostri, altrimenti (ultimo vince) annullerebbero -march=znver3.
    export CFLAGS="${CFLAGS} -O3 -march=znver3 -mtune=znver3"
    export CXXFLAGS="${CXXFLAGS} -O3 -march=znver3 -mtune=znver3"
  else
    export CFLAGS="-O3 -msse4.2 -mpopcnt -mavx -mavx2 -mfma -mbmi -mbmi2 -mmovbe ${CFLAGS}"
    export CXXFLAGS="-O3 -msse4.2 -mpopcnt -mavx -mavx2 -mfma -mbmi -mbmi2 -mmovbe ${CXXFLAGS}"
  fi

  CONFIGURE_ARGS=(
    --enable-release
    --enable-optimizations
    --enable-all-engines
    --enable-ext-sse2
    --enable-ext-avx2
    --disable-debug
    --prefix=/usr
  )

  ./configure "${CONFIGURE_ARGS[@]}"
  make -j"$(nproc)"
}

package() {
  cd scummvm
  make install DESTDIR="$pkgdir"
}
